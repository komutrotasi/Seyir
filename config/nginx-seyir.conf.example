# Bu parçayı ilgili server { } bloğuna uyarlayın.
# Kök yol ve PHP-FPM socket değeri sunucuya göre değiştirilmelidir.

add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.meb.k12.tr https://*.meb.gov.tr https://*.ytimg.com https://*.youtube.com; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://api.aladhan.com; media-src 'self' blob: data: https:; object-src 'none'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'" always;

# Git metadatası ve diğer gizli dosyalar hiçbir zaman yayınlanmaz.
# ACME doğrulaması için .well-known istisnası korunur.
location ~ /\.(?!well-known(?:/|$)) {
    deny all;
}

location ~* \.(?:md|sh|bat)$ {
    deny all;
}

location = /admin.php {
    return 302 /admin.html;
}

location ^~ /config/ {
    deny all;
}

location ~* ^/(?:tests|tools|lib)/ {
    deny all;
}

location ~* ^/data/.*\.(?:log|tmp|bak|private\.json)$ {
    deny all;
}

location ~* ^/.*\.private\.json$ {
    deny all;
}

location = /fetch-haberler.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass unix:/run/php/php-fpm.sock;
}

location = /fetch-gorsel.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass unix:/run/php/php-fpm.sock;
}
